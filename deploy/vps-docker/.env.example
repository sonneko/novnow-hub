# VPS + Docker 構成の環境変数例（M7 §2.1）。
#
# 本ファイルはプレースホルダの例。実際の値はアカウント側で設定し、
# `.env`（REF:.gitignore で除外）に書き、リポジトリには載せない。

# 公開ベース URL（VPS のドメイン／IP に合わせて設定）。
HUB_PUBLIC_BASE=https://novnow.example.com

# GitHub OAuth（GitHub 側の OAuth App 設定と一致させる）。
HUB_GITHUB_OAUTH_CLIENT_ID=
HUB_GITHUB_OAUTH_CLIENT_SECRET=
HUB_GITHUB_OAUTH_REDIRECT_URI=

# Webhook 署名検証用の秘密（ランダム値を生成して設定）。
HUB_WEBHOOK_SECRET=
