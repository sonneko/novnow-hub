{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "novnow-hub",
  "version": "0.0.0",
  "identifier": "com.sonneko.novnow-hub",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web"
    },
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    },
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "novnow-hub"
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
