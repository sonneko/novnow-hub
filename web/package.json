{
  "name": "novnow-hub-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "mock": "prism mock ../api/openapi.yaml --host 0.0.0.0 --port 4010",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/lib/api/generated/schema.d.ts",
    "check:api": "openapi-typescript ../api/openapi.yaml -o src/lib/api/generated/schema.d.ts --check",
    "check": "npm run check:api && npm test && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "astro build",
    "preview": "astro preview",
    "tauri": "cd .. && tauri"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/svelte": "^8.1.2",
    "@stoplight/prism-cli": "^5.14.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "astro": "^6.4.8",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
