---
import AppShell from '../../components/shell/AppShell.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { placeholderChapters } from '../../lib/placeholders';

export function getStaticPaths() {
  return placeholderChapters.map((chapter) => ({
    params: { id: chapter.id },
  }));
}

const { id } = Astro.params;
---

<BaseLayout title="読者ビュー | novnow-hub">
  <AppShell client:load page={{ kind: 'reader', chapterId: id! }} />
</BaseLayout>
